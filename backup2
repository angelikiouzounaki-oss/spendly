<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Spendly">

<title>Spendly</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box !important; margin: 0 !important; padding: 0 !important; }
:root {
  --border: #c2d0f7; --border2: #a8bdf5;
  --text: #0f1f5c; --text2: #3a4e9a; --text3: #7a8cc0;
  --accent: #2d5be3; --accent-dark: #1e44c8;
  --accent-bg: #eef2fd; --accent-light: #dce6fc;
}
html, body { background: #fff !important; font-family: -apple-system,'Helvetica Neue',sans-serif !important; color: #0f1f5c !important; min-height: 100vh !important; -webkit-font-smoothing: antialiased; }
#app { max-width: 430px !important; margin: 0 auto !important; padding-bottom: 120px !important; }
button { -webkit-appearance: none !important; appearance: none !important; font-family: inherit !important; }

/* NAV */
.nav { display: flex !important; position: fixed !important; bottom: 0 !important; left: 50% !important; transform: translateX(-50%) !important; width: 100% !important; max-width: 430px !important; background: #fff !important; border-top: 2px solid #c2d0f7 !important; padding: 10px 8px 24px !important; z-index: 100 !important; gap: 6px !important; }
.nav-btn { flex: 1 !important; display: flex !important; flex-direction: column !important; align-items: center !important; gap: 4px !important; background: #dce6fc !important; border: 2px solid #a8bdf5 !important; border-radius: 12px !important; cursor: pointer !important; color: #2d5be3 !important; font-size: 10px !important; font-weight: 700 !important; letter-spacing: 0.04em !important; padding: 8px 4px 6px !important; }
.nav-btn.active { background: #2d5be3 !important; border-color: #1e44c8 !important; color: #fff !important; }
.nav-icon { font-size: 18px !important; line-height: 1 !important; }

/* ADD BTN */
.add-btn { position: fixed !important; bottom: 86px !important; left: 50% !important; transform: translateX(-50%) !important; width: calc(100% - 16px) !important; max-width: 414px !important; background: #dce6fc !important; border: 2px solid #a8bdf5 !important; border-radius: 12px !important; color: #2d5be3 !important; font-size: 14px !important; font-weight: 700 !important; cursor: pointer !important; display: flex !important; align-items: center !important; justify-content: center !important; gap: 8px !important; padding: 12px 0 !important; z-index: 101 !important; }
.add-btn:active { background: #2d5be3 !important; color: #fff !important; }

/* HEADER */
.header { padding: 12px 20px 0 !important; }
.header-inner { background: #2d5be3 !important; border-radius: 14px !important; padding: 14px 16px 14px !important; }
.period-tabs { display: flex !important; gap: 5px !important; margin-bottom: 12px !important; }
.period-tab { flex: 1 !important; padding: 6px 4px !important; border-radius: 8px !important; font-size: 11px !important; font-weight: 700 !important; border: 1.5px solid rgba(255,255,255,0.3) !important; background: rgba(255,255,255,0.15) !important; color: rgba(255,255,255,0.75) !important; cursor: pointer !important; text-align: center !important; }
.period-tab.active { background: #fff !important; border-color: #fff !important; color: #2d5be3 !important; }
.period-nav { display: flex !important; align-items: center !important; justify-content: space-between !important; }
.period-btn { background: rgba(255,255,255,0.2) !important; border: 1.5px solid rgba(255,255,255,0.4) !important; border-radius: 50% !important; width: 30px !important; height: 30px !important; cursor: pointer !important; color: #fff !important; font-size: 16px !important; font-weight: 700 !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; }
.period-btn:active { background: rgba(255,255,255,0.4) !important; }
.period-btn.disabled { opacity: 0.25 !important; cursor: default !important; pointer-events: none !important; }
.period-label-wrap { flex: 1 !important; text-align: center !important; }
.period-main { font-size: 16px !important; font-weight: 800 !important; color: #fff !important; line-height: 1.2 !important; }
.period-sub { font-size: 11px !important; color: rgba(255,255,255,0.75) !important; font-weight: 600 !important; margin-top: 2px !important; background: rgba(255,255,255,0.2) !important; border-radius: 6px !important; display: inline-block !important; padding: 1px 8px !important; }

/* SUMMARY */
.summary { padding: 14px 20px 16px !important; display: grid !important; grid-template-columns: 1fr 1fr !important; gap: 10px !important; }
.card { background: #fff !important; border: 2px solid #c2d0f7 !important; border-radius: 14px !important; padding: 14px 16px !important; }
.card-label { font-size: 11px !important; color: #7a8cc0 !important; letter-spacing: 0.06em !important; text-transform: uppercase !important; margin-bottom: 4px !important; font-weight: 600 !important; }
.card-value { font-size: 20px !important; font-weight: 800 !important; letter-spacing: -0.5px !important; color: #0f1f5c !important; }
.card-sub { font-size: 11px !important; color: #3a4e9a !important; margin-top: 2px !important; }
.card.accent { background: #2d5be3 !important; border-color: #1e44c8 !important; grid-column: 1/-1 !important; }
.card.accent .card-label { color: rgba(255,255,255,0.75) !important; }
.card.accent .card-value { color: #fff !important; font-size: 28px !important; }
.card.accent .card-sub { color: rgba(255,255,255,0.65) !important; }
.card.small-blue { background: #eef2fd !important; border-color: #c2d0f7 !important; }
.card.small-blue .card-value { color: #2d5be3 !important; font-size: 18px !important; }

/* WEEK BARS */
.week-section { background: #eef2fd !important; border: 2px solid #c2d0f7 !important; border-radius: 14px !important; margin: 0 20px 16px !important; padding: 16px 16px 14px !important; }
.section-title { font-size: 12px !important; font-weight: 800 !important; color: #3a4e9a !important; letter-spacing: 0.07em !important; text-transform: uppercase !important; margin-bottom: 10px !important; }
.week-bar-wrap { display: flex !important; align-items: flex-end !important; gap: 5px !important; height: 70px !important; }
.week-bar-col { flex: 1 !important; display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: flex-end !important; height: 100% !important; }
.week-bar { width: 100% !important; border-radius: 4px 4px 0 0 !important; min-height: 3px !important; }
.week-amt-label { font-size: 8px !important; color: #3a4e9a !important; margin-bottom: 2px !important; font-weight: 600 !important; text-align: center !important; }
.week-day-label { font-size: 9px !important; font-weight: 600 !important; color: #7a8cc0 !important; margin-top: 4px !important; text-align: center !important; }
.week-day-label.today-lbl { color: #2d5be3 !important; font-weight: 800 !important; }
.today-badge { display: inline-block !important; background: #2d5be3 !important; color: #fff !important; font-size: 8px !important; font-weight: 700 !important; border-radius: 5px !important; padding: 1px 4px !important; margin-bottom: 2px !important; }

/* BLOCKS */
.block { background: #fff !important; border: 2px solid #c2d0f7 !important; border-radius: 14px !important; padding: 4px 14px !important; margin: 0 20px 16px !important; }
.cat-item { display: flex !important; align-items: center !important; gap: 12px !important; padding: 10px 0 !important; border-bottom: 1.5px solid #c2d0f7 !important; cursor: pointer !important; }
.cat-item:last-child { border-bottom: none !important; }
.cat-icon { width: 36px !important; height: 36px !important; border-radius: 10px !important; display: flex !important; align-items: center !important; justify-content: center !important; font-size: 17px !important; flex-shrink: 0 !important; }
.cat-info { flex: 1 !important; min-width: 0 !important; }
.cat-name { font-size: 13px !important; font-weight: 600 !important; color: #0f1f5c !important; }
.cat-bar-wrap { height: 4px !important; background: #eef2fd !important; border-radius: 2px !important; margin-top: 4px !important; }
.cat-bar { height: 4px !important; border-radius: 2px !important; }
.cat-amount { font-size: 13px !important; font-weight: 700 !important; color: #0f1f5c !important; text-align: right !important; }
.cat-pct { font-size: 11px !important; color: #7a8cc0 !important; text-align: right !important; margin-top: 2px !important; }
.cat-arrow { font-size: 14px !important; color: #a8bdf5 !important; margin-left: 4px !important; flex-shrink: 0 !important; }

/* TX */
.tx-item { display: flex !important; align-items: center !important; gap: 12px !important; padding: 10px 0 !important; border-bottom: 1.5px solid #c2d0f7 !important; }
.tx-item:last-child { border-bottom: none !important; }
.tx-icon { width: 38px !important; height: 38px !important; border-radius: 10px !important; display: flex !important; align-items: center !important; justify-content: center !important; font-size: 17px !important; flex-shrink: 0 !important; }
.tx-info { flex: 1 !important; min-width: 0 !important; }
.tx-store { font-size: 13px !important; font-weight: 600 !important; color: #0f1f5c !important; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }
.tx-meta { font-size: 11px !important; color: #7a8cc0 !important; margin-top: 1px !important; }
.tx-time { font-size: 10px !important; color: #7a8cc0 !important; margin-top: 2px !important; font-style: italic !important; }
.tx-amount { font-size: 13px !important; font-weight: 700 !important; color: #0f1f5c !important; }
.delete-btn { background: #fdecea !important; border: 1.5px solid #f5c1c1 !important; color: #c0392b !important; font-size: 11px !important; font-weight: 700 !important; border-radius: 8px !important; cursor: pointer !important; padding: 3px 8px !important; margin-top: 3px !important; }
.date-label { font-size: 11px !important; font-weight: 700 !important; color: #3a4e9a !important; letter-spacing: 0.06em !important; text-transform: uppercase !important; padding: 12px 0 4px !important; border-bottom: 1.5px solid #c2d0f7 !important; margin-bottom: 2px !important; }

/* EXPORT BAR */
.export-bar { display: flex !important; align-items: center !important; justify-content: center !important; gap: 8px !important; margin: 0 20px 12px !important; padding: 12px !important; background: #dce6fc !important; border: 2px solid #a8bdf5 !important; border-radius: 12px !important; cursor: pointer !important; color: #2d5be3 !important; font-size: 14px !important; font-weight: 700 !important; width: calc(100% - 40px) !important; }

/* CHART */
.chart-wrap { background: #fff !important; border: 2px solid #c2d0f7 !important; border-radius: 14px !important; padding: 16px !important; margin: 0 20px 16px !important; }
.chart-tabs { display: flex !important; gap: 8px !important; margin-bottom: 14px !important; }
.chart-tab { flex: 1 !important; padding: 9px 10px !important; border-radius: 12px !important; font-size: 12px !important; font-weight: 700 !important; border: 2px solid #a8bdf5 !important; background: #dce6fc !important; cursor: pointer !important; color: #2d5be3 !important; text-align: center !important; }
.chart-tab.active { background: #2d5be3 !important; border-color: #1e44c8 !important; color: #fff !important; }

/* MODAL — no display in CSS, controlled only by JS */
.modal-overlay { position: fixed !important; inset: 0 !important; background: rgba(15,31,92,0.35) !important; z-index: 200 !important; align-items: flex-end !important; justify-content: center !important; }
.modal { background: #fff !important; border-radius: 24px 24px 0 0 !important; width: 100% !important; max-width: 430px !important; padding: 20px 20px 40px !important; max-height: 88vh !important; overflow-y: scroll !important; -webkit-overflow-scrolling: touch !important; transition: transform 0.25s ease !important; }
.modal-handle { width: 40px !important; height: 4px !important; background: #a8bdf5 !important; border-radius: 2px !important; margin: 0 auto 16px !important; }
.modal-title { font-size: 17px !important; font-weight: 800 !important; color: #0f1f5c !important; margin-bottom: 20px !important; text-align: center !important; }
.form-row { margin-bottom: 14px !important; }
.form-label { font-size: 11px !important; font-weight: 800 !important; color: #3a4e9a !important; margin-bottom: 6px !important; letter-spacing: 0.06em !important; text-transform: uppercase !important; display: block !important; }
.form-input { width: 100% !important; background: #eef2fd !important; border: 2px solid #c2d0f7 !important; border-radius: 8px !important; padding: 11px 14px !important; font-size: 15px !important; color: #0f1f5c !important; outline: none !important; -webkit-appearance: none !important; }
.form-input:focus { border-color: #2d5be3 !important; background: #dce6fc !important; }
.amount-input { font-size: 28px !important; font-weight: 800 !important; text-align: center !important; color: #2d5be3 !important; }
.cat-grid { display: grid !important; grid-template-columns: repeat(3,1fr) !important; gap: 8px !important; }
.cat-choice { background: #eef2fd !important; border: 2px solid #c2d0f7 !important; border-radius: 8px !important; padding: 10px 6px !important; text-align: center !important; cursor: pointer !important; }
.cat-choice.selected { border-color: #2d5be3 !important; background: #dce6fc !important; }
.cat-choice-icon { font-size: 20px !important; }
.cat-choice-label { font-size: 10px !important; color: #3a4e9a !important; margin-top: 3px !important; line-height: 1.2 !important; font-weight: 600 !important; }
.pills-wrap { display: flex !important; flex-wrap: wrap !important; gap: 7px !important; }
.pill { padding: 6px 13px !important; border-radius: 20px !important; font-size: 12px !important; font-weight: 600 !important; border: 2px solid #c2d0f7 !important; background: #dce6fc !important; cursor: pointer !important; color: #2d5be3 !important; white-space: nowrap !important; }
.pill.selected { background: #2d5be3 !important; border-color: #1e44c8 !important; color: #fff !important; }
.pill.add-pill { border-style: dashed !important; color: #7a8cc0 !important; background: #fff !important; }
.tag-pill { padding: 5px 11px !important; border-radius: 20px !important; font-size: 12px !important; font-weight: 600 !important; border: 2px solid #c2d0f7 !important; background: #dce6fc !important; cursor: pointer !important; color: #3a4e9a !important; }
.tag-pill.selected { background: #2d5be3 !important; border-color: #1e44c8 !important; color: #fff !important; }
.custom-input-row { display: flex !important; gap: 8px !important; margin-top: 8px !important; }
.custom-input-row input { flex: 1 !important; }
.custom-input-row button { background: #2d5be3 !important; color: #fff !important; border: none !important; border-radius: 8px !important; padding: 0 16px !important; font-size: 13px !important; font-weight: 700 !important; cursor: pointer !important; height: 44px !important; }
.submit-btn { width: 100% !important; background: #2d5be3 !important; color: #fff !important; border: 2px solid #1e44c8 !important; border-radius: 12px !important; padding: 15px !important; font-size: 16px !important; font-weight: 800 !important; cursor: pointer !important; margin-top: 10px !important; }
.cancel-modal-btn { width: 100% !important; background: #dce6fc !important; color: #2d5be3 !important; border: 2px solid #a8bdf5 !important; border-radius: 12px !important; padding: 13px !important; font-size: 15px !important; font-weight: 700 !important; cursor: pointer !important; margin-top: 8px !important; }

/* CONFIRM */
.confirm-overlay { position: fixed !important; inset: 0 !important; background: rgba(15,31,92,0.4) !important; z-index: 300 !important; align-items: center !important; justify-content: center !important; padding: 20px !important; }
.confirm-box { background: #fff !important; border-radius: 18px !important; padding: 28px 24px !important; width: 100% !important; max-width: 340px !important; text-align: center !important; }
.confirm-title { font-size: 17px !important; font-weight: 800 !important; color: #0f1f5c !important; margin-bottom: 8px !important; }
.confirm-msg { font-size: 14px !important; color: #7a8cc0 !important; margin-bottom: 24px !important; line-height: 1.5 !important; }
.confirm-btns { display: flex !important; gap: 10px !important; }
.confirm-cancel { flex: 1 !important; padding: 12px !important; background: #dce6fc !important; border: 2px solid #a8bdf5 !important; border-radius: 12px !important; color: #2d5be3 !important; font-size: 15px !important; font-weight: 700 !important; cursor: pointer !important; }
.confirm-delete { flex: 1 !important; padding: 12px !important; background: #c0392b !important; border: 2px solid #992d22 !important; border-radius: 12px !important; color: #fff !important; font-size: 15px !important; font-weight: 700 !important; cursor: pointer !important; }

/* DRILL DOWN */
.drill-overlay { position: fixed !important; inset: 0 !important; background: rgba(15,31,92,0.35) !important; z-index: 250 !important; align-items: flex-end !important; justify-content: center !important; }
.drill-modal { background: #fff !important; border-radius: 24px 24px 0 0 !important; width: 100% !important; max-width: 430px !important; padding: 20px 20px 40px !important; max-height: 80vh !important; overflow-y: auto !important; transition: transform 0.28s ease !important; }
.drill-header { display: flex !important; align-items: center !important; gap: 12px !important; margin-bottom: 16px !important; }
.drill-icon { width: 40px !important; height: 40px !important; border-radius: 12px !important; display: flex !important; align-items: center !important; justify-content: center !important; font-size: 20px !important; flex-shrink: 0 !important; }
.drill-title { font-size: 17px !important; font-weight: 800 !important; color: #0f1f5c !important; }
.drill-total { font-size: 13px !important; color: #7a8cc0 !important; margin-top: 2px !important; }
.drill-row { display: flex !important; align-items: center !important; justify-content: space-between !important; padding: 10px 0 !important; border-bottom: 1.5px solid #c2d0f7 !important; }
.drill-row:last-child { border-bottom: none !important; }
.drill-store { font-size: 14px !important; font-weight: 600 !important; color: #0f1f5c !important; }
.drill-count { font-size: 11px !important; color: #7a8cc0 !important; margin-top: 2px !important; }
.drill-amount { font-size: 14px !important; font-weight: 700 !important; color: #0f1f5c !important; }
.drill-pct { font-size: 11px !important; color: #7a8cc0 !important; text-align: right !important; margin-top: 2px !important; }

/* EXPORT MODAL */
.export-modal { background: #fff !important; border-radius: 24px 24px 0 0 !important; width: 100% !important; max-width: 430px !important; padding: 16px 20px 40px !important; }
.export-option { display: flex !important; align-items: center !important; gap: 12px !important; padding: 14px !important; background: #eef2fd !important; border: 2px solid #c2d0f7 !important; border-radius: 12px !important; cursor: pointer !important; margin-bottom: 10px !important; }
.export-option:active { background: #dce6fc !important; }
.export-icon { font-size: 22px !important; }
.export-name { font-size: 14px !important; font-weight: 700 !important; color: #0f1f5c !important; }
.export-desc { font-size: 12px !important; color: #7a8cc0 !important; margin-top: 2px !important; }
.cancel-btn { width: 100% !important; margin-top: 8px !important; padding: 12px !important; background: #dce6fc !important; border: 2px solid #a8bdf5 !important; border-radius: 12px !important; color: #2d5be3 !important; font-size: 14px !important; font-weight: 700 !important; cursor: pointer !important; }

/* HORIZONTAL BAR CHART */
.hbar-row { display: flex !important; align-items: center !important; gap: 10px !important; margin-bottom: 10px !important; }
.hbar-label { font-size: 12px !important; font-weight: 600 !important; color: #0f1f5c !important; width: 88px !important; flex-shrink: 0 !important; display: flex !important; align-items: center !important; gap: 6px !important; }
.hbar-track { flex: 1 !important; height: 10px !important; background: #eef2fd !important; border-radius: 5px !important; overflow: hidden !important; }
.hbar-fill { height: 10px !important; border-radius: 5px !important; }
.hbar-val { font-size: 11px !important; font-weight: 700 !important; color: #3a4e9a !important; width: 52px !important; text-align: right !important; flex-shrink: 0 !important; }

.page { display: none !important; }
.page.active { display: block !important; }
.empty-state { text-align: center !important; padding: 28px 20px !important; color: #7a8cc0 !important; font-size: 14px !important; }
.sec-pad { padding: 16px 20px 8px !important; }
</style>
</head>
<body>
<div id="app">

  <!-- HOME -->
  <div id="page-home" class="page active">
    <div class="header">
      <div class="header-inner">
        <div class="period-tabs">
          <button class="period-tab active" onclick="setPeriod('today',this)">Today</button>
          <button class="period-tab" onclick="setPeriod('week',this)">Week</button>
          <button class="period-tab" onclick="setPeriod('month',this)">Month</button>
          <button class="period-tab" onclick="setPeriod('year',this)">Year</button>
        </div>
        <div class="period-nav">
          <button class="period-btn" id="home-prev" onclick="navigatePeriod(-1)">&#8249;</button>
          <div class="period-label-wrap">
            <div class="period-main" id="period-main-label"></div>
            <div id="period-sub-wrap" style="margin-top:3px;text-align:center;display:none;"></div>
          </div>
          <button class="period-btn" id="home-next" onclick="navigatePeriod(1)">&#8250;</button>
        </div>
      </div>
    </div>
    <div class="summary">
      <div class="card accent">
        <div class="card-label" id="total-label">Spent this month</div>
        <div class="card-value" id="total-spent">€0.00</div>
        <div class="card-sub" id="tx-count">0 transactions</div>
      </div>
      <div class="card small-blue">
        <div class="card-label" id="card1-label">Transactions</div>
        <div class="card-value" id="card1-val">0</div>
        <div class="card-sub" id="card1-sub"></div>
      </div>
      <div class="card small-blue">
        <div class="card-label" id="card2-label">Daily avg</div>
        <div class="card-value" id="card2-val">€0.00</div>
        <div class="card-sub" id="card2-sub"></div>
      </div>
    </div>
    <div class="week-section" id="bar-section">
      <div class="section-title" id="bar-title">Breakdown</div>
      <div class="week-bar-wrap" id="week-bars"></div>
      <div style="display:flex;gap:5px;margin-top:2px;" id="week-labels"></div>
    </div>
    <div class="sec-pad"><div class="section-title">Top 5 categories</div></div>
    <div class="block" id="cat-list"><div class="empty-state">No expenses yet</div></div>
    <div class="sec-pad"><div class="section-title">Last 10 transactions</div></div>
    <div class="block" id="recent-tx-list"><div class="empty-state">No transactions yet</div></div>
  </div>

  <!-- TRANSACTIONS -->
  <div id="page-tx" class="page">
    <div class="header">
      <div class="header-inner">
        <div class="period-tabs">
          <button class="period-tab active" onclick="setPeriodTx('today',this)">Today</button>
          <button class="period-tab" onclick="setPeriodTx('week',this)">Week</button>
          <button class="period-tab" onclick="setPeriodTx('month',this)">Month</button>
          <button class="period-tab" onclick="setPeriodTx('year',this)">Year</button>
        </div>
        <div class="period-nav">
          <button class="period-btn" id="tx-prev" onclick="navigatePeriodTx(-1)">&#8249;</button>
          <div class="period-label-wrap">
            <div class="period-main" id="tx-period-main"></div>
            <div id="tx-period-sub-wrap" style="margin-top:3px;text-align:center;display:none;"></div>
          </div>
