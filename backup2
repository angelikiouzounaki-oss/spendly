// ── DRILL DOWN ──
function setupSwipe(sheetEl, closeFn){
  let sy=0,dragging=false;
  const handle=sheetEl.querySelector('.modal-handle');
  if(!handle)return;
  handle.addEventListener('touchstart',e=>{sy=e.touches[0].clientY;dragging=true;sheetEl.style.transition='none';},{passive:true});
  handle.addEventListener('touchmove',e=>{
    if(!dragging)return;
    const dy=Math.max(0,e.touches[0].clientY-sy);
    sheetEl.style.transform='translateY('+dy+'px)';
  },{passive:true});
  handle.addEventListener('touchend',e=>{
    if(!dragging)return;dragging=false;
    const dy=e.changedTouches[0].clientY-sy;
    sheetEl.style.transition='transform 0.25s ease';
    if(dy>80){sheetEl.style.transform='translateY(100%)';setTimeout(closeFn,250);}
    else{sheetEl.style.transform='translateY(0)';}
  },{passive:true});
}

function openDrill(catId){
  const {start,end}=getDateRange(activePeriod,periodOffset);
  const cat=CATEGORIES.find(c=>c.id===catId);
  const txs=filterByRange(start,end).filter(e=>e.category===catId);
  const total=txs.reduce((s,e)=>s+e.amount,0);

  document.getElementById('drill-icon').style.background=cat.bg;
  document.getElementById('drill-icon').textContent=cat.icon;
  document.getElementById('drill-title').textContent=cat.label;
  document.getElementById('drill-total').textContent=fmt(total)+' total · '+txs.length+' transaction'+(txs.length!==1?'s':'');

  // Group by store
  const byStore={};
  txs.forEach(e=>{
    const key=e.store||'Other';
    if(!byStore[key])byStore[key]={amount:0,count:0};
    byStore[key].amount+=e.amount;
    byStore[key].count++;
  });
  const sorted=Object.entries(byStore).sort((a,b)=>b[1].amount-a[1].amount);
  const content=document.getElementById('drill-content');
  if(!sorted.length){content.innerHTML='<div class="empty-state">No transactions</div>';
  } else {
    content.innerHTML=sorted.map(([store,data])=>{
      const pct=total>0?Math.round(data.amount/total*100):0;
      return `<div class="drill-row">
        <div>
          <div class="drill-store">${store}</div>
          <div class="drill-count">${data.count} transaction${data.count!==1?'s':''} · ${pct}%</div>
        </div>
        <div style="text-align:right;">
          <div class="drill-amount">${fmt(data.amount)}</div>
        </div>
      </div>`;
    }).join('');
  }
  const dm=document.getElementById('drill-modal');
  const ds=dm.querySelector('.drill-modal');
  ds.style.transform='translateY(100%)';
  dm.style.display='flex';
  requestAnimationFrame(()=>{ds.style.transition='transform 0.28s ease';ds.style.transform='translateY(0)';});
  setupSwipe(ds,()=>{dm.style.display='none';ds.style.transform='';});
}
function closeDrillOutside(e){if(e.target.id==='drill-modal')document.getElementById('drill-modal').style.display='none';}

