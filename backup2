<script>
const CATEGORIES=[
  {id:'groceries',label:'Groceries',icon:'🛒',color:'#2d8a4e',bg:'#e8f5ee'},
  {id:'restaurants',label:'Restaurants',icon:'🍽',color:'#c0622a',bg:'#fdf0e8'},
  {id:'transport',label:'Transport',icon:'🚗',color:'#2d5be3',bg:'#eef2fd'},
  {id:'shopping',label:'Shopping',icon:'🛍',color:'#8b3daf',bg:'#f5ecfb'},
  {id:'housing',label:'Housing',icon:'🏠',color:'#5a6370',bg:'#f0f1f3'},
  {id:'health',label:'Health',icon:'💊',color:'#c0392b',bg:'#fdecea'},
  {id:'entertainment',label:'Entertainment',icon:'🎬',color:'#d97706',bg:'#fef3e2'},
  {id:'travel',label:'Travel',icon:'✈️',color:'#0891b2',bg:'#e0f7fa'},
  {id:'subscriptions',label:'Subscriptions',icon:'📱',color:'#6b7280',bg:'#f3f4f6'},
  {id:'other',label:'Other',icon:'📦',color:'#9ca3af',bg:'#f9fafb'},
];
const STORES={
  groceries:['Albert Heijn','Jumbo','Lidl','Penny','Kaufland','DM','Kruidvat','Action','Other'],
  restaurants:['Delivery','Restaurant','Café / Bar','Fast Food','Other'],
  transport:['NS','DB','Taxi','Bus','GVB','Arriva','Other'],
  shopping:['Clothes & Shoes','Books','Gifts','Games','Apps','Health & Beauty','Electronics','Other'],
  housing:['Rent','Other'],
  health:['Psychologist','Doctor','Medication','Health Insurance','Other'],
  entertainment:['Cinema','Concert','Museum','Theme Park','Other'],
  travel:['Accommodation','Plane','Train','Car','Activities','Other'],
  subscriptions:['Netflix','Spotify','Lebara','Apple','Google','Bunq','ABN','Revolut','Other'],
  other:['Other'],
};
const STORE_LABELS={groceries:'Supermarket',restaurants:'Type',transport:'Provider',shopping:'Type',housing:'Type',health:'Provider',entertainment:'Venue',travel:'Type',subscriptions:'Service',other:'Type'};
const TAGS={transport:['Work commute','Travel','Hangout','Errand','Other']};

let customStores=JSON.parse(localStorage.getItem('spendly_custom')||'{}');
let expenses=JSON.parse(localStorage.getItem('spendly_v3')||'[]');
let activePeriod='today', periodOffset=0;
let activePeriodTx='today', periodOffsetTx=0;
let chartsDate=new Date();
let selCat='groceries', selStore='', selTag='';
let pieChart=null, monthlyChart=null, weeklyChart=null;
let pendingDeleteId=null;
let chartPeriod='month', chartOffset=0;

// ── SWIPE TO CLOSE (smooth) ──
let touchStartY=0, dragging=false;
const modalInner=()=>document.getElementById('modal-inner');
document.addEventListener('touchstart',e=>{
  if(document.getElementById('modal').style.display==='flex'){
    touchStartY=e.touches[0].clientY; dragging=true;
  }
},{passive:true});
document.addEventListener('touchmove',e=>{
  if(!dragging) return;
  const dy=e.touches[0].clientY-touchStartY;
  if(dy>0) { e.preventDefault(); modalInner().style.transform=`translateY(${Math.max(0,dy)}px)`; }
},{passive:false});
document.addEventListener('touchend',e=>{
  if(!dragging) return; dragging=false;
  const dy=e.changedTouches[0].clientY-touchStartY;
  if(dy>100){ askCancelModal(); }
  else { modalInner().style.transform=''; }
});

function save(){localStorage.setItem('spendly_v3',JSON.stringify(expenses));localStorage.setItem('spendly_custom',JSON.stringify(customStores));}
function fmt(n){return '€'+Number(n).toFixed(2);}
function fmtShort(n){return n>=1000?'€'+(n/1000).toFixed(1)+'k':'€'+Math.round(n);}

// ── PERIOD LOGIC ──
function getDateRange(period,offset){
  const today=new Date(); today.setHours(0,0,0,0);
  let start,end,mainLabel,subLabel,totalLabel;
  if(period==='today'){
    const d=new Date(today); d.setDate(d.getDate()+offset);
    start=new Date(d); end=new Date(d); end.setHours(23,59,59,999);
    mainLabel=d.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
    subLabel=offset===0?'Today':'';
    totalLabel='Spent today';
  } else if(period==='week'){
    const ws=new Date(today); ws.setDate(today.getDate()-((today.getDay()+6)%7)+(offset*7));
    const we=new Date(ws); we.setDate(ws.getDate()+6); we.setHours(23,59,59,999);
    start=ws; end=we;
    mainLabel=ws.toLocaleDateString('en-GB',{day:'numeric',month:'short'})+' – '+we.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
    subLabel=offset===0?'This week':'';
    totalLabel='Spent this week';
  } else if(period==='month'){
    const d=new Date(today.getFullYear(),today.getMonth()+offset,1);
    start=new Date(d.getFullYear(),d.getMonth(),1);
    end=new Date(d.getFullYear(),d.getMonth()+1,0); end.setHours(23,59,59,999);
    mainLabel=d.toLocaleString('default',{month:'long'})+' '+d.getFullYear();
    subLabel=offset===0?'This month':'';
    totalLabel='Spent this month';
  } else {
    const yr=today.getFullYear()+offset;
    start=new Date(yr,0,1); end=new Date(yr,11,31); end.setHours(23,59,59,999);
    mainLabel=yr.toString();
    subLabel=offset===0?'This year':'';
    totalLabel='Spent this year';
  }
  return {start,end,mainLabel,subLabel,totalLabel};
}

function isAtPresent(period,offset){return offset===0;}

function filterByRange(start,end){
  return expenses.filter(e=>{const d=new Date(e.date);d.setHours(12);return d>=start&&d<=end;});
}

function setSubLabel(wrapId,text){
  const el=document.getElementById(wrapId);
  if(!el) return;
  el.style.display=text?'block':'none';
  el.innerHTML=text?`<span class="period-sub">${text}</span>`:'';
}

// ── OVERVIEW ──
function setPeriod(p,btn){
  activePeriod=p; periodOffset=0;
  document.querySelectorAll('#page-home .period-tab').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  renderOverview();
}
function navigatePeriod(dir){
  if(dir>0 && periodOffset>=0) return;
  periodOffset+=dir;
  renderOverview();
}
function renderOverview(){
  const {start,end,mainLabel,subLabel,totalLabel}=getDateRange(activePeriod,periodOffset);
  document.getElementById('period-main-label').textContent=mainLabel;
  setSubLabel('period-sub-wrap',subLabel);
  document.getElementById('total-label').textContent=totalLabel;
  // next button disabled if at present
  document.getElementById('home-next').classList.toggle('disabled', periodOffset>=0);

  const txs=filterByRange(start,end);
  const total=txs.reduce((s,e)=>s+e.amount,0);
  document.getElementById('total-spent').textContent=fmt(total);
  document.getElementById('tx-count').textContent=txs.length+' transaction'+(txs.length!==1?'s':'');
  renderContextCards(activePeriod,txs,start,end,total);
  renderBars(activePeriod,txs,start,end);
  renderCatList(txs,total);
  const recentAll=[...expenses].sort((a,b)=>new Date(b.date+'T'+(b.time||'00:00'))-new Date(a.date+'T'+(a.time||'00:00'))).slice(0,10);
  renderRecentTx(recentAll);
}

function renderContextCards(period,txs,start,end,total){
  const lbl1=document.getElementById('card1-label'),val1=document.getElementById('card1-val'),sub1=document.getElementById('card1-sub');
  const lbl2=document.getElementById('card2-label'),val2=document.getElementById('card2-val'),sub2=document.getElementById('card2-sub');
  if(period==='today'){
    const biggest=txs.length?txs.reduce((a,b)=>a.amount>b.amount?a:b,txs[0]):null;
    lbl1.textContent='Highest expense';
    val1.textContent=biggest?fmt(biggest.amount):'€0.00';
    sub1.textContent=biggest?(biggest.store||'—'):'';
    lbl2.textContent='Transactions';
    val2.textContent=txs.length;
    sub2.textContent='today';
  } else if(period==='week'){
    lbl1.textContent='Transactions';
    val1.textContent=txs.length;
    sub1.textContent='this week';
    lbl2.textContent='Daily avg';
    val2.textContent=fmt(total/7);
    sub2.textContent='per day';
  } else if(period==='month'){
    lbl1.textContent='Transactions';
    val1.textContent=txs.length;
    sub1.textContent='this month';
    const days=Math.round((end-start)/(1000*60*60*24))+1;
    lbl2.textContent='Daily avg';
    val2.textContent=fmt(days>0?total/days:0);
    sub2.textContent='per day';
  } else {
    lbl1.textContent='Transactions';
    val1.textContent=txs.length;
    sub1.textContent='this year';
    const monthMap={};
    txs.forEach(e=>{const m=e.date.slice(0,7);monthMap[m]=(monthMap[m]||0)+e.amount;});
    const cnt=Object.keys(monthMap).length;
    lbl2.textContent='Monthly avg';
    val2.textContent=fmt(cnt?total/cnt:0);
    sub2.textContent='per month';
  }
}

function renderBars(period,txs,start,end){
  const barsEl=document.getElementById('week-bars');
  const labelsEl=document.getElementById('week-labels');
  const title=document.getElementById('bar-title');
  const today=new Date(); today.setHours(0,0,0,0);

  if(period==='today'){
    title.textContent='Spending by time of day';
    const blocks=['00–06','06–12','12–18','18–24'];
    const amts=[0,0,0,0];
    txs.forEach(e=>{if(e.time){const h=parseInt(e.time.split(':')[0]);amts[Math.min(3,Math.floor(h/6))]+=e.amount;}});
    const max=Math.max(...amts,1);
    barsEl.innerHTML=amts.map(a=>`<div class="week-bar-col">${a>0?`<div class="week-amt-label">${fmtShort(a)}</div>`:'<div class="week-amt-label" style="opacity:0;">·</div>'}<div class="week-bar" style="height:${Math.max(4,Math.round(a/max*52))}px;background:#c2d0f7;"></div></div>`).join('');
    labelsEl.innerHTML=blocks.map(b=>`<div style="flex:1;text-align:center;" class="week-day-label">${b}</div>`).join('');
  } else if(period==='week'){
    title.textContent='This week by day';
    const days=['Mo','Tu','We','Th','Fr','Sa','Su'],amts=[0,0,0,0,0,0,0];
    for(let i=0;i<7;i++){const wd=new Date(start);wd.setDate(start.getDate()+i);txs.forEach(e=>{const d=new Date(e.date);d.setHours(12);if(d.toDateString()===wd.toDateString())amts[i]+=e.amount;});}
    const max=Math.max(...amts,1);
    const ti=periodOffset===0?(today.getDay()+6)%7:-1;
    barsEl.innerHTML=amts.map((a,i)=>`<div class="week-bar-col">${a>0?`<div class="week-amt-label">${fmtShort(a)}</div>`:'<div class="week-amt-label" style="opacity:0;">·</div>'}<div class="week-bar" style="height:${Math.max(4,Math.round(a/max*52))}px;background:${i===ti?'#2d5be3':'#c2d0f7'};"></div></div>`).join('');
    labelsEl.innerHTML=days.map((d,i)=>`<div style="flex:1;text-align:center;">${i===ti?'<div class="today-badge">Today</div>':''}<div class="week-day-label${i===ti?' today-lbl':''}">${d}</div></div>`).join('');
  } else if(period==='month'){
    title.textContent='This month by week';
    const weeks=[];
    let cur=new Date(start);
    while(cur<=end){const wEnd=new Date(cur);wEnd.setDate(cur.getDate()+6);if(wEnd>end)wEnd.setTime(end.getTime());weeks.push({s:new Date(cur),e:new Date(wEnd)});cur.setDate(cur.getDate()+7);}
    const amts=weeks.map(w=>txs.filter(e=>{const d=new Date(e.date);d.setHours(12);return d>=w.s&&d<=w.e;}).reduce((s,e)=>s+e.amount,0));
    const max=Math.max(...amts,1);
    barsEl.innerHTML=amts.map(a=>`<div class="week-bar-col">${a>0?`<div class="week-amt-label">${fmtShort(a)}</div>`:'<div class="week-amt-label" style="opacity:0;">·</div>'}<div class="week-bar" style="height:${Math.max(4,Math.round(a/max*52))}px;background:#c2d0f7;"></div></div>`).join('');
    labelsEl.innerHTML=weeks.map((_,i)=>`<div style="flex:1;text-align:center;" class="week-day-label">W${i+1}</div>`).join('');
  } else {
    title.textContent='This year by month';
    const months=['J','F','M','A','M','J','J','A','S','O','N','D'];
    const yr=start.getFullYear();
    const amts=months.map((_,m)=>txs.filter(e=>{const d=new Date(e.date);return d.getFullYear()===yr&&d.getMonth()===m;}).reduce((s,e)=>s+e.amount,0));
    const max=Math.max(...amts,1);
    const curM=periodOffset===0?today.getMonth():-1;
    barsEl.innerHTML=amts.map((a,i)=>`<div class="week-bar-col">${a>0?`<div class="week-amt-label">${fmtShort(a)}</div>`:'<div class="week-amt-label" style="opacity:0;">·</div>'}<div class="week-bar" style="height:${Math.max(4,Math.round(a/max*52))}px;background:${i===curM?'#2d5be3':'#c2d0f7'};"></div></div>`).join('');
    labelsEl.innerHTML=months.map((m,i)=>`<div style="flex:1;text-align:center;" class="week-day-label${i===curM?' today-lbl':''}">${m}</div>`).join('');
  }
}

function renderCatList(txs,total){
  const el=document.getElementById('cat-list');
  if(!txs.length){el.innerHTML='<div class="empty-state">No expenses yet</div>';return;}
  const bycat={};CATEGORIES.forEach(c=>bycat[c.id]=0);
  txs.forEach(e=>{if(bycat[e.category]!==undefined)bycat[e.category]+=e.amount;});
  el.innerHTML=CATEGORIES.filter(c=>bycat[c.id]>0).sort((a,b)=>bycat[b.id]-bycat[a.id]).slice(0,5).map(c=>{
    const amt=bycat[c.id],pct=total>0?Math.round(amt/total*100):0;
    return `<div class="cat-item" onclick="openDrill('${c.id}')">
      <div class="cat-icon" style="background:${c.bg};">${c.icon}</div>
      <div class="cat-info"><div class="cat-name">${c.label}</div>
        <div class="cat-bar-wrap"><div class="cat-bar" style="width:${pct}%;background:${c.color};"></div></div></div>
      <div><div class="cat-amount">${fmt(amt)}</div><div class="cat-pct">${pct}%</div></div>
      <div class="cat-arrow">&#8250;</div>
    </div>`;
  }).join('');
}

function makeTxHTML(e,showDelete){
  const cat=CATEGORIES.find(c=>c.id===e.category)||CATEGORIES[0];
  const lbl=[e.store,e.tag].filter(Boolean).join(' · ');
  const timeStr=e.time?`Recorded at ${e.time}`:`${new Date(e.date).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'})}`;
  return `<div class="tx-item">
    <div class="tx-icon" style="background:${cat.bg};">${cat.icon}</div>
    <div class="tx-info">
      <div class="tx-store">${lbl||cat.label}</div>
      <div class="tx-meta">${cat.label}${e.note?' · '+e.note:''}</div>
      <div class="tx-time">${timeStr}</div>
    </div>
    <div style="text-align:right;flex-shrink:0;">
      <div class="tx-amount">${fmt(e.amount)}</div>
      ${showDelete?`<button class="delete-btn" onclick="askDelete('${e.id}','${(lbl||cat.label).replace(/'/g,"\\'").replace(/"/g,'&quot;')}',${e.amount})">Delete</button>`:''}
    </div>
  </div>`;
}

function renderRecentTx(list){
  const el=document.getElementById('recent-tx-list');
  if(!list.length){el.innerHTML='<div class="empty-state">No transactions yet</div>';return;}
