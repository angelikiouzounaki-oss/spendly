function monthTxsChart(date){
  const d=date||chartsDate;
  return expenses.filter(e=>{const ed=new Date(e.date);return ed.getMonth()===d.getMonth()&&ed.getFullYear()===d.getFullYear();});
}

function renderTrendChart(){
  const {start,end}=getDateRange(chartPeriod,chartOffset);
  const txs=filterByRange(start,end);
  let labels=[], fullLabels=[], amounts=[], xLabel='';

  if(chartPeriod==='today'){
    // Hours of the day 0-23
    xLabel='Hours of the day';
    for(let h=0;h<24;h++){
      const hEnd=new Date(start);hEnd.setHours(h,59,59,999);
      const hStart=new Date(start);hStart.setHours(h,0,0,0);
      const total=txs.filter(e=>e.time&&parseInt(e.time.split(':')[0])===h).reduce((s,e)=>s+e.amount,0);
      labels.push(h%6===0?h+'h':'');
      fullLabels.push(h+':00 – '+h+':59');
      amounts.push(parseFloat(total.toFixed(2)));
    }
  } else if(chartPeriod==='week'){
    // Days of the week
    xLabel='Days of the week';
    const dayNames=['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];
    const dayFull=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
    for(let i=0;i<7;i++){
      const d=new Date(start);d.setDate(start.getDate()+i);
      const de=new Date(d);de.setHours(23,59,59,999);
      amounts.push(parseFloat(filterByRange(d,de).reduce((s,e)=>s+e.amount,0).toFixed(2)));
      labels.push(dayNames[i]);
      fullLabels.push(dayFull[i]+' '+d.toLocaleDateString('en-GB',{day:'numeric',month:'short'}));
    }
  } else if(chartPeriod==='month'){
    // Weeks of the month
    xLabel='Weeks of the month';
    const weeks=[];let cur=new Date(start);
    while(cur<=end){
      const we=new Date(cur);we.setDate(cur.getDate()+6);
      if(we>end)we.setTime(end.getTime());
      weeks.push({s:new Date(cur),e:new Date(we)});
      cur=new Date(we);cur.setDate(cur.getDate()+1);
    }
    weeks.forEach((w,i)=>{
      amounts.push(parseFloat(filterByRange(w.s,w.e).reduce((s,e)=>s+e.amount,0).toFixed(2)));
      labels.push('W'+(i+1));
      fullLabels.push(w.s.toLocaleDateString('en-GB',{day:'numeric',month:'short'})+' – '+w.e.toLocaleDateString('en-GB',{day:'numeric',month:'short'}));
    });
  } else {
    // Months of the year
    xLabel='Months of the year';
    const yr=start.getFullYear();
    const mns=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const mnsFull=['January','February','March','April','May','June','July','August','September','October','November','December'];
    for(let m=0;m<12;m++){
      const ms=new Date(yr,m,1),me=new Date(yr,m+1,0);me.setHours(23,59,59,999);
      amounts.push(parseFloat(filterByRange(ms,me).reduce((s,e)=>s+e.amount,0).toFixed(2)));
      labels.push(mns[m]);
      fullLabels.push(mnsFull[m]+' '+yr);
    }
  }

  // Destroy old chart
  if(window.spendlyTrendChart) window.spendlyTrendChart.destroy();

  const ctx=document.getElementById('trend-chart').getContext('2d');
  window.spendlyTrendChart=new Chart(ctx,{
    type:'line',
    data:{
      labels,
      datasets:[{
        data:amounts,
        borderColor:'#2d5be3',
        backgroundColor:'rgba(45,91,227,0.08)',
        pointBackgroundColor:'#2d5be3',
        pointBorderColor:'#ffffff',
        pointBorderWidth:2,
        pointRadius:5,
        pointHoverRadius:7,
        tension:0.35,
        fill:true,
        borderWidth:2.5
      }]
    },
    options:{
      responsive:true,
      maintainAspectRatio:false,
      plugins:{
        legend:{display:false},
        tooltip:{callbacks:{
          title:ctx=>fullLabels[ctx[0].dataIndex]||labels[ctx[0].dataIndex],
          label:ctx=>' '+fmt(ctx.parsed.y)
        }}
      },
      scales:{
        y:{
          beginAtZero:true,
          grid:{color:'#eef2fd'},
          ticks:{callback:v=>'€'+v,color:'#7a8cc0',font:{size:11}}
        },
        x:{
          grid:{display:false},
          ticks:{color:'#7a8cc0',font:{size:10,weight:'600'},maxRotation:0}
        }
      }
    }
  });

  const xl=document.getElementById('trend-x-label');
  if(xl) xl.textContent=xLabel;
}

function renderPieChart(){
  const {start:ps,end:pe}=getDateRange(chartPeriod,chartOffset);
  const txs=filterByRange(ps,pe),bycat={};
  CATEGORIES.forEach(c=>bycat[c.id]=0);
  txs.forEach(e=>{if(bycat[e.category]!==undefined)bycat[e.category]+=e.amount;});
  const used=CATEGORIES.filter(c=>bycat[c.id]>0).map(c=>({...c,amount:bycat[c.id]}));
  if(pieChart)pieChart.destroy();
  const pieLeg=document.getElementById('pie-legend');
  if(!used.length){pieLeg.innerHTML='<div style="color:#7a8cc0;font-size:13px;width:100%;text-align:center;">No data</div>';return;}
  const totalAmt=used.reduce((s,c)=>s+c.amount,0);
  pieChart=new Chart(document.getElementById('pie-chart').getContext('2d'),{
    type:'pie',
    data:{labels:used.map(c=>c.label),datasets:[{data:used.map(c=>c.amount),backgroundColor:used.map(c=>c.color),borderWidth:2,borderColor:'#fff',hoverOffset:6}]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>' '+fmt(ctx.parsed)+' ('+Math.round(ctx.parsed/totalAmt*100)+'%)'}}}}
  });
  pieLeg.innerHTML=used.map(c=>`<span style="display:flex;align-items:center;gap:5px;font-size:12px;color:#3a4e9a;font-weight:600;"><span style="width:10px;height:10px;border-radius:2px;background:${c.color};display:inline-block;"></span>${c.label} ${fmt(c.amount)}</span>`).join('');
}


function renderHBars(){
  const {start:hs,end:he}=getDateRange(chartPeriod,chartOffset);
  const txs=filterByRange(hs,he);
  const total=txs.reduce((s,e)=>s+e.amount,0);
  const el=document.getElementById('hbar-wrap');
  if(!txs.length){el.innerHTML='<div class="empty-state">No data for this month</div>';return;}
  const bycat={};CATEGORIES.forEach(c=>bycat[c.id]=0);
  txs.forEach(e=>{if(bycat[e.category]!==undefined)bycat[e.category]+=e.amount;});
  const sorted=CATEGORIES.filter(c=>bycat[c.id]>0).sort((a,b)=>bycat[b.id]-bycat[a.id]);
  const max=Math.max(...sorted.map(c=>bycat[c.id]),1);
  el.innerHTML=sorted.map(c=>{
    const amt=bycat[c.id];
    const pct=Math.round(amt/max*100);
    return `<div class="hbar-row">
      <div class="hbar-label"><span>${c.icon}</span><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${c.label}</span></div>
      <div class="hbar-track"><div class="hbar-fill" style="width:${pct}%;background:${c.color};"></div></div>
      <div class="hbar-val">${fmt(amt)}</div>
    </div>`;
  }).join('');
}

