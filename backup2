  document.getElementById('modal').style.display='flex';
  setTimeout(()=>document.getElementById('inp-amount').focus(),200);
}
function closeModalOutside(e){if(e.target.id==='modal')askCancelModal();}
function addExpense(){
  const amount=parseFloat(document.getElementById('inp-amount').value);
  const date=document.getElementById('inp-date').value;
  const note=document.getElementById('inp-note').value.trim();
  if(!amount||amount<=0||!date){alert('Please enter a valid amount and date.');return;}
  const now=new Date();
  const time=now.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
  expenses.push({id:Date.now().toString(),amount,store:selStore,tag:selTag,note,date,time,category:selCat});
  save();forceCloseModal();renderOverview();renderTxPage();
}

