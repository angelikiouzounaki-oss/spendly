function closeExportOutside(e){if(e.target.id==='export-modal')document.getElementById('export-modal').style.display='none';}
function downloadFile(content,filename,type){const blob=new Blob([content],{type});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=filename;a.click();URL.revokeObjectURL(url);document.getElementById('export-modal').style.display='none';}
function exportCSV(scope){
  const {start,end}=getDateRange(activePeriodTx,periodOffsetTx);
  const rows=scope==='period'?filterByRange(start,end):expenses;
  const headers=['Date','Time','Category','Store','Purpose','Note','Amount (EUR)'];
  const lines=rows.map(e=>{const cat=CATEGORIES.find(c=>c.id===e.category)||{label:'Other'};return[e.date,e.time||'',cat.label,e.store||'',e.tag||'',e.note||'',e.amount.toFixed(2)].map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',');});
  downloadFile([headers.join(','),...lines].join('\n'),scope==='period'?'spendly_period.csv':'spendly_all.csv','text/csv');
}
function exportJSON(){downloadFile(JSON.stringify({exported:new Date().toISOString(),expenses},null,2),'spendly_backup.json','application/json');}
function triggerImport(){document.getElementById('import-file-input').click();}
function importJSON(event){
  const file=event.target.files[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=function(e){
    try{
      const data=JSON.parse(e.target.result);
      const imported=Array.isArray(data)?data:(data.expenses||[]);
      if(!imported.length){alert('No expenses found in this file.');return;}
      if(confirm('Import '+imported.length+' transactions? This will REPLACE your current data.')){
        expenses=imported;
        save();
        document.getElementById('export-modal').style.display='none';
        renderOverview();
        renderTxPage();
        alert('Imported '+imported.length+' transactions successfully!');
      }
    }catch(err){alert('Could not read file. Make sure it\'s a valid Spendly backup.');}
    event.target.value='';
  };
  reader.readAsText(file);
}

// ── FORM ──
function allStores(c){const def=STORES[c]||['Other'],cus=customStores[c]||[];return[...def,...cus.filter(s=>!def.includes(s))];}
function buildStorePills(c){
  document.getElementById('store-label').textContent=STORE_LABELS[c]||'Type';
  const stores=allStores(c);selStore=stores[0];
  document.getElementById('store-pills').innerHTML=stores.map((s,i)=>`<div class="pill${i===0?' selected':''}" onclick="pickStore(this,'${s.replace(/'/g,"\\'")}')">${s}</div>`).join('')+`<div class="pill add-pill" onclick="toggleCustomInput()">+ Add</div>`;
  document.getElementById('custom-store-row').style.display='none';
}
function buildTagPills(c){
  const tags=TAGS[c]||[],row=document.getElementById('tag-row');
  if(!tags.length){row.style.display='none';selTag='';return;}
  row.style.display='block';selTag=tags[0];
  document.getElementById('tag-pills').innerHTML=tags.map((t,i)=>`<div class="tag-pill${i===0?' selected':''}" onclick="pickTag(this,'${t}')">${t}</div>`).join('');
}
function pickStore(el,name){document.querySelectorAll('#store-pills .pill').forEach(p=>p.classList.remove('selected'));el.classList.add('selected');selStore=name;document.getElementById('custom-store-row').style.display='none';}
function toggleCustomInput(){const r=document.getElementById('custom-store-row');r.style.display=r.style.display==='none'?'flex':'none';if(r.style.display==='flex')document.getElementById('inp-custom-store').focus();}
function addCustomStore(){
  const val=document.getElementById('inp-custom-store').value.trim();if(!val)return;
  if(!customStores[selCat])customStores[selCat]=[];
  if(!customStores[selCat].includes(val))customStores[selCat].push(val);
  save();buildStorePills(selCat);
  document.getElementById('custom-store-row').style.display='none';
  document.getElementById('inp-custom-store').value='';
  const pills=document.querySelectorAll('#store-pills .pill:not(.add-pill)'),last=pills[pills.length-1];
  if(last){document.querySelectorAll('#store-pills .pill').forEach(p=>p.classList.remove('selected'));last.classList.add('selected');selStore=val;}
}
function pickTag(el,tag){document.querySelectorAll('.tag-pill').forEach(p=>p.classList.remove('selected'));el.classList.add('selected');selTag=tag;}
function buildCatGrid(){
  document.getElementById('cat-grid').innerHTML=CATEGORIES.map(c=>`<div class="cat-choice${c.id===selCat?' selected':''}" onclick="pickCat('${c.id}',this)"><div class="cat-choice-icon">${c.icon}</div><div class="cat-choice-label">${c.label}</div></div>`).join('');
}
function pickCat(id,el){selCat=id;document.querySelectorAll('.cat-choice').forEach(c=>c.classList.remove('selected'));el.classList.add('selected');buildStorePills(id);buildTagPills(id);}

function askCancelModal(){
  const amount=document.getElementById('inp-amount').value;
  const hasData=amount&&parseFloat(amount)>0;
  if(hasData){document.getElementById('cancel-modal-confirm').style.display='flex';}
  else{forceCloseModal();}
}
function forceCloseModal(){
  document.getElementById('cancel-modal-confirm').style.display='none';
  modalInner().style.transform='';
  document.getElementById('modal').style.display='none';
}
function openModal(){
  document.getElementById('inp-amount').value='';document.getElementById('inp-note').value='';document.getElementById('inp-custom-store').value='';
  document.getElementById('inp-date').value=new Date().toISOString().split('T')[0];
